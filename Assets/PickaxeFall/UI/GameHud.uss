.screen { flex-grow: 1; color: rgb(39, 40, 31); font-size: 36px; -unity-font-style: normal; }
Label { white-space: normal; flex-shrink: 0; }
.safe { flex-grow: 1; padding: 20px 24px 16px; }
.header { flex-shrink: 0; }
.brand-row { flex-direction: row; align-items: center; margin-bottom: 12px; }
.brand { flex-grow: 1; font-size: 48px; color: rgb(255, 247, 215); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(27, 30, 23); }
.header-buttons { flex-direction: row; }
.stone-button { background-color: rgb(114, 119, 105); color: rgb(255, 255, 239); border-top-width: 5px; border-left-width: 5px; border-right-width: 5px; border-bottom-width: 7px; border-top-color: rgb(225, 227, 205); border-left-color: rgb(202, 207, 181); border-right-color: rgb(53, 60, 43); border-bottom-color: rgb(35, 42, 28); border-radius: 0; -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(24, 28, 19); margin: 0; padding: 12px; -unity-text-align: middle-center; white-space: normal; flex-shrink: 0; }
.stone-button:hover { background-color: rgb(142, 151, 112); color: rgb(255, 255, 218); }
.stone-button:active { border-top-color: rgb(42, 51, 31); border-left-color: rgb(45, 55, 33); border-bottom-color: rgb(213, 225, 177); border-right-color: rgb(207, 220, 166); }
.stone-button:disabled { background-color: rgb(151, 151, 139); color: rgb(232, 231, 214); -unity-text-outline-width: 0; border-top-color: rgb(201, 201, 185); border-left-color: rgb(188, 189, 171); border-right-color: rgb(110, 112, 96); border-bottom-color: rgb(99, 101, 85); }
.small-button { font-size: 36px; min-width: 132px; height: 132px; margin-left: 12px; }
.stats-row { flex-direction: row; background-color: rgb(43, 43, 33); padding: 4px; }
.inset { border-top-width: 4px; border-left-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-top-color: rgb(65, 67, 54); border-left-color: rgb(78, 81, 63); border-right-color: rgb(235, 238, 213); border-bottom-color: rgb(245, 247, 225); }
.stat { flex-grow: 1; flex-basis: 0; background-color: rgb(200, 201, 181); padding: 8px 14px; margin: 3px; }
.stat-title { font-size: 30px; color: rgb(65, 68, 47); }
.stat-value { font-size: 48px; color: rgb(31, 40, 20); }
.scene-info { flex-direction: row; justify-content: space-between; background-color: rgba(27, 35, 26, 0.96); padding: 12px 16px; margin-top: 5px; flex-shrink: 0; }
.micro { font-size: 30px; }
.light { color: rgb(242, 239, 213); }
.hub-window { flex-grow: 1; flex-shrink: 1; min-height: 0; background-color: rgb(37, 39, 29); margin-top: 12px; padding: 6px; }
.page-scroll { flex-grow: 1; min-height: 0; }
.inventory-panel { background-color: rgb(204, 205, 184); padding: 24px; min-height: 0; }
.title { font-size: 48px; color: rgb(31, 37, 22); margin-bottom: 18px; }
.description { font-size: 36px; color: rgb(59, 64, 43); margin-bottom: 22px; }
.roulette { flex-direction: row; height: 172px; margin-bottom: 24px; flex-shrink: 0; }
.tool-slot { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; background-color: rgb(151, 157, 129); margin: 0 4px; }
.tool-slot.selected { background-color: rgb(187, 209, 109); border-top-color: rgb(70, 91, 24); border-left-color: rgb(70, 91, 24); border-right-color: rgb(249, 255, 202); border-bottom-color: rgb(249, 255, 202); }
.slot-icon { width: 96px; height: 96px; }
.slot-odds { font-size: 36px; color: rgb(34, 46, 16); }
.hero { flex-direction: row; align-items: center; margin-bottom: 24px; flex-shrink: 0; }
.hero-icon { width: 144px; height: 144px; background-color: rgb(153, 159, 132); margin-right: 24px; flex-shrink: 0; }
.hero-info { flex-shrink: 1; }
.hero-name { font-size: 42px; color: rgb(31, 41, 19); }
.hero-detail { font-size: 36px; color: rgb(58, 66, 39); margin-top: 10px; }
.primary { min-height: 144px; background-color: rgb(92, 121, 40); border-top-color: rgb(193, 219, 127); border-left-color: rgb(170, 198, 98); border-right-color: rgb(48, 70, 20); border-bottom-color: rgb(34, 51, 13); font-size: 48px; }
.primary:hover { background-color: rgb(116, 146, 53); }
.secondary { min-height: 144px; margin-top: 20px; font-size: 42px; }
.footnote { font-size: 34px; color: rgb(66, 70, 47); white-space: normal; margin-top: 20px; }
.section-label { font-size: 36px; color: rgb(62, 68, 43); margin-bottom: 12px; }
.result { font-size: 38px; color: rgb(50, 80, 23); margin-bottom: 18px; }
.resource-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 20px; flex-shrink: 0; }
.resource-slot { width: 23%; margin: 1%; height: 192px; background-color: rgb(152, 158, 129); align-items: center; }
.resource-icon { width: 86px; height: 86px; margin-top: 10px; }
.stack-count { color: rgb(25, 34, 15); font-size: 38px; }
.resource-name { font-size: 28px; color: rgb(40, 50, 23); -unity-text-align: middle-center; }
.tabs { flex-direction: row; margin-top: 12px; flex-shrink: 0; }
.tab { flex-grow: 1; flex-basis: 0; min-height: 144px; margin: 0 4px; font-size: 42px; padding: 4px; }
.active { background-color: rgb(92, 122, 39); border-top-color: rgb(198, 223, 133); border-left-color: rgb(172, 204, 101); }
.playfield { flex-grow: 1; min-height: 60px; }
.mining-panel { background-color: rgb(196, 202, 173); border-width: 5px; border-top-color: rgb(244, 250, 223); border-left-color: rgb(226, 237, 195); border-right-color: rgb(72, 87, 46); border-bottom-color: rgb(44, 60, 25); padding: 16px; flex-shrink: 0; }
.tool-status-row { flex-direction: row; justify-content: center; margin-bottom: 10px; }
.tool-status { flex-grow: 1; flex-basis: 0; align-items: center; margin: 0 6px; }
.tool-status-icon { width: 84px; height: 84px; }
.tool-health { font-size: 36px; color: rgb(34, 46, 20); }
.health-track { width: 100%; height: 18px; background-color: rgb(48, 61, 27); margin-top: 7px; }
.health-fill { height: 12px; background-color: rgb(107, 162, 52); }
.compact.resource-grid { margin-bottom: 0; }
.compact .resource-slot { width: 11.5%; margin: 0.5%; height: 118px; }
.compact .resource-icon { width: 60px; height: 60px; margin-top: 6px; }
.compact .stack-count { font-size: 34px; }
.toast { position: absolute; top: 24%; left: 4%; right: 4%; background-color: rgba(29, 38, 20, 0.97); border-width: 4px; border-top-color: rgb(195, 201, 143); border-left-color: rgb(171, 184, 119); border-right-color: rgb(42, 56, 23); border-bottom-color: rgb(24, 36, 12); padding: 18px 24px; color: rgb(255, 248, 199); font-size: 38px; -unity-text-align: middle-center; }
.pause-overlay, .modal-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(17, 24, 12, 0.9); justify-content: center; padding: 50px 32px; }
.modal-card { background-color: rgb(209, 211, 187); border-width: 6px; border-top-color: rgb(251, 255, 226); border-left-color: rgb(237, 247, 201); border-right-color: rgb(74, 88, 46); border-bottom-color: rgb(47, 63, 26); padding: 32px; }
.modal-scroll { max-height: 94%; }
.quantity-input { font-size: 48px; height: 126px; margin: 8px 0 20px; flex-shrink: 0; }
.quantity-input .unity-text-field__input { background-color: rgb(248, 249, 228); color: rgb(29, 39, 17); padding: 16px 24px; border-width: 4px; border-color: rgb(77, 95, 46); }
.sale-quote { font-size: 38px; color: rgb(40, 74, 18); margin-bottom: 20px; }
.bag-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 20px; }
.resource-card { width: 48%; margin: 1%; height: 282px; background-color: rgb(159, 168, 134); color: rgb(30, 43, 17); border-radius: 0; align-items: center; justify-content: center; padding: 8px; flex-shrink: 0; }
.resource-card:hover { background-color: rgb(183, 195, 148); }
.bag-icon { width: 90px; height: 90px; }
.bag-name { font-size: 36px; -unity-text-align: middle-center; }
.bag-count { font-size: 44px; color: rgb(29, 53, 12); }
.bag-price { font-size: 32px; color: rgb(53, 69, 32); }
.goal-note { font-size: 34px; background-color: rgb(185, 194, 151); padding: 18px; color: rgb(47, 68, 23); margin-bottom: 20px; }
.shop-categories { flex-direction: row; margin-bottom: 22px; }
.category { flex-grow: 1; flex-basis: 0; min-height: 144px; margin: 0 4px; padding: 2px; font-size: 36px; }
.tier-selector { flex-direction: row; margin-bottom: 16px; }
.tier-button { flex-grow: 1; flex-basis: 0; height: 144px; align-items: center; justify-content: center; margin: 0 5px; }
.tier-icon { width: 100px; height: 100px; }
.selected-tool { font-size: 44px; margin-bottom: 24px; color: rgb(44, 65, 21); }
.upgrade-card { background-color: rgb(184, 194, 155); padding: 24px; margin-bottom: 24px; flex-shrink: 0; }
.upgrade-card.pinned { border-top-color: rgb(107, 133, 57); border-left-color: rgb(107, 133, 57); }
.upgrade-title { font-size: 44px; color: rgb(28, 46, 13); margin-bottom: 16px; }
.upgrade-effect { font-size: 42px; color: rgb(47, 89, 17); margin-bottom: 16px; }
.upgrade-price { font-size: 36px; color: rgb(51, 65, 29); margin-bottom: 12px; }
.upgrade-resources { font-size: 34px; color: rgb(55, 70, 32); margin-bottom: 12px; }
.upgrade-reason { font-size: 32px; color: rgb(61, 85, 34); }
.missing { color: rgb(126, 55, 31); }
.soon-panel { padding: 24px; background-color: rgb(178, 185, 155); }
.fatal-error { flex-grow: 1; background-color: rgb(35, 36, 27); color: rgb(255, 244, 210); font-size: 48px; padding: 80px 40px; white-space: normal; }
.settings-button { min-width: 240px; font-size: 32px; }
.pause-glyph { width: 44px; height: 52px; flex-direction: row; justify-content: space-between; align-self: center; }
.pause-bar { width: 14px; height: 52px; background-color: rgb(255, 255, 239); }
.mine-window { background-color: transparent; padding: 0; justify-content: flex-end; }
.mine-panel { flex-shrink: 0; border-width: 6px; border-top-color: rgb(246, 249, 218); border-left-color: rgb(230, 238, 193); border-right-color: rgb(77, 90, 47); border-bottom-color: rgb(45, 61, 25); }
.mine-panel .title { font-size: 44px; margin-bottom: 12px; }
.mine-panel .description { font-size: 32px; margin-bottom: 16px; }
.mine-panel .hero { margin-bottom: 16px; }
.mine-panel .hero-icon { width: 116px; height: 116px; }
.mine-panel .hero-name { font-size: 38px; }
.mine-panel .hero-detail { font-size: 32px; }
.mine-panel .roulette { height: 144px; margin-bottom: 16px; }
.mine-panel .slot-icon { width: 82px; height: 82px; }
.mine-panel .slot-odds { font-size: 32px; }
.mine-panel .footnote { font-size: 30px; margin-top: 12px; }
.settings-row { flex-direction: row; margin-bottom: 24px; }
.settings-choice { flex-grow: 1; flex-basis: 0; height: 128px; font-size: 40px; margin-right: 12px; }
.settings-switch { font-size: 32px; min-height: 100px; margin: 10px 0; }
.volume-slider { height: 100px; margin: 12px 0; }
.volume-slider .unity-base-slider__dragger { width: 54px; height: 70px; background-color: rgb(120, 174, 68); border-radius: 0; border-width: 5px; border-top-color: rgb(198, 230, 144); border-left-color: rgb(198, 230, 144); border-right-color: rgb(44, 66, 27); border-bottom-color: rgb(44, 66, 27); }

.energy-panel { margin-bottom: 12px; }
.energy-label { font-size: 30px; color: rgb(27, 53, 57); }
.energy-track { height: 18px; background-color: rgb(31, 53, 54); margin: 6px 0; }
.energy-fill { height: 18px; background-color: rgb(55, 171, 184); }
.ability-help { font-size: 28px; color: rgb(53, 66, 54); }
.tool-status { border-width: 4px; border-color: transparent; padding: 4px; }
.tool-selected { border-color: rgb(139, 112, 34); background-color: rgb(222, 219, 157); }
.benefit-summary { font-size: 28px; margin: 8px 0; }
.benefits-button { font-size: 28px; min-height: 64px; margin: 8px 0; }
.category { font-size: 28px; }

.recipe-resources { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
.recipe-item { flex-direction: row; align-items: center; margin: 4px 22px 10px 0; }
.recipe-icon { width: 44px; height: 44px; margin-right: 12px; flex-shrink: 0; }
.recipe-amount { font-size: 34px; }
.cost-enough { color: rgb(30, 102, 24); }
.cost-short { color: rgb(161, 35, 29); }
.stone-button.buy-ready { background-color: rgb(49, 119, 43); border-top-color: rgb(153, 211, 120); border-left-color: rgb(133, 193, 101); border-right-color: rgb(28, 65, 26); border-bottom-color: rgb(20, 49, 19); }
.stone-button.buy-ready:hover { background-color: rgb(65, 142, 52); }
.stone-button.buy-blocked, .stone-button.buy-blocked:disabled { background-color: rgb(146, 47, 40); color: rgb(255, 241, 225); border-top-color: rgb(220, 137, 116); border-left-color: rgb(202, 111, 95); border-right-color: rgb(84, 29, 24); border-bottom-color: rgb(66, 21, 18); -unity-text-outline-width: 0.5px; }
.tool-selected { border-width: 2px; border-color: rgb(227, 193, 53); background-color: transparent; }
.fps-options { flex-wrap: wrap; }
.fps-options .settings-choice { flex-basis: 22%; min-width: 160px; height: 104px; font-size: 32px; margin: 6px; }
.channel-button { font-size: 34px; min-height: 92px; margin: 10px 0 24px; }
.loot-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.loot-float { position: absolute; width: 112px; height: 38px; flex-direction: row; align-items: center; justify-content: center; }
.loot-number { color: rgb(255, 252, 215); font-size: 28px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(18, 27, 14); }
.loot-icon { width: 28px; height: 28px; margin-left: 6px; flex-shrink: 0; }
.tutorial-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(13, 22, 15, 0.86); justify-content: center; padding: 64px 32px; }
.tutorial-scroll { max-height: 96%; }
.tutorial-art { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 24px; }
.tutorial-icon { width: 150px; height: 150px; margin: 8px 20px; }
.tutorial-arrows { font-size: 54px; color: rgb(33, 96, 91); }
.tutorial-body { font-size: 38px; color: rgb(35, 51, 27); margin-bottom: 28px; }
.tutorial-actions { flex-direction: row; }
.tutorial-nav { flex-grow: 1; flex-basis: 0; min-height: 124px; font-size: 38px; margin: 6px; }
.tutorial-skip { font-size: 30px; min-height: 90px; margin-top: 18px; }
.tutorial-focus { border-color: rgb(121, 229, 213); }

/* Profile progression and construction, 0.6.0 */
.profile-button { min-width: 110px; }
.level-ready { background-color: rgb(65, 111, 53); border-bottom-color: rgb(233, 203, 93); }
.requirement-row { margin-bottom: 14px; padding-bottom: 12px; border-bottom-width: 2px; border-bottom-color: rgb(64, 66, 59); }
.profile-material { margin-top: 5px; margin-bottom: 5px; flex-shrink: 0; }
.goal-button { margin-top: 8px; }
.skill-lock { height: 204px; position: relative; margin-top: 12px; overflow: hidden; background-color: rgba(19, 23, 26, 0.85); flex-shrink: 0; }
.chain { position: absolute; top: 35px; width: 43%; height: 18px; flex-direction: row; justify-content: space-around; }
.chain-left { left: 0; }
.chain-right { right: 0; }
.chain-link { width: 26px; height: 14px; border-top-width: 4px; border-bottom-width: 4px; border-left-width: 3px; border-right-width: 3px; border-top-color: rgb(145, 151, 151); border-bottom-color: rgb(62, 68, 75); border-left-color: rgb(95, 103, 109); border-right-color: rgb(95, 103, 109); }
.lock-art { position: absolute; width: 54px; height: 64px; left: 45%; top: 6px; }
.lock-shackle { position: absolute; top: 0; left: 10px; width: 34px; height: 30px; border-top-width: 7px; border-left-width: 7px; border-right-width: 7px; border-top-color: rgb(166, 173, 173); border-left-color: rgb(118, 126, 130); border-right-color: rgb(118, 126, 130); }
.lock-body { position: absolute; top: 24px; width: 54px; height: 36px; background-color: rgb(123, 120, 100); border-bottom-width: 6px; border-bottom-color: rgb(71, 69, 61); }
.lock-keyhole { position: absolute; top: 34px; left: 22px; width: 10px; height: 16px; background-color: rgb(28, 32, 35); }
.lock-ready .lock-body { background-color: rgb(239, 194, 79); border-bottom-color: rgb(158, 112, 40); }
.lock-label { position: absolute; top: 74px; width: 100%; -unity-text-align: middle-center; font-size: 28px; color: rgb(195, 198, 184); }
.lock-ready .lock-label { color: rgb(254, 221, 116); }
.lock-button { position: absolute; bottom: 6px; left: 10px; right: 10px; height: 88px; min-height: 88px; font-size: 32px; }
.map-navigation { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
.construction-scene { height: 330px; position: relative; overflow: hidden; border-top-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-right-width: 5px; border-top-color: rgb(17, 23, 28); border-bottom-color: rgb(67, 73, 69); border-left-color: rgb(17, 23, 28); border-right-color: rgb(67, 73, 69); margin-bottom: 18px; flex-shrink: 0; }
.construction-flight { position: absolute; flex-direction: row; background-color: rgba(20, 28, 30, 0.85); padding-left: 6px; padding-right: 6px; height: 40px; }
.map-coming-soon { opacity: 0.65; -unity-text-align: middle-center; padding-top: 14px; padding-bottom: 14px; }

/* 0.6.1: compact paper cards and full-card seals */
.compact-skill { position: relative; padding: 20px; margin-top: 0; margin-bottom: 14px; border-width: 3px; background-color: rgb(206, 207, 183); border-top-color: rgb(241, 241, 212); border-left-color: rgb(235, 237, 204); border-right-color: rgb(91, 100, 70); border-bottom-color: rgb(77, 86, 57); }
.skill-content { flex-shrink: 0; }
.skill-heading { flex-direction: row; align-items: center; margin-right: 64px; margin-bottom: 8px; }
.compact-skill .upgrade-title { flex-grow: 1; flex-shrink: 1; font-size: 36px; margin-bottom: 0; }
.skill-info { width: 58px; height: 58px; min-width: 58px; padding: 0; margin: 0 0 0 10px; font-size: 32px; color: rgb(65, 76, 47); background-color: rgba(0, 0, 0, 0); border-width: 2px; border-color: rgb(124, 135, 100); border-radius: 0; }
.skill-summary { font-size: 28px; color: rgb(81, 87, 62); margin-bottom: 6px; }
.compact-skill .upgrade-effect { font-size: 31px; margin-top: 4px; margin-bottom: 12px; }
.skill-price-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 10px; }
.compact-skill .upgrade-price { font-size: 30px; margin-right: 20px; margin-bottom: 0; }
.compact-skill .recipe-resources { margin-bottom: 0; flex-grow: 1; }
.compact-skill .recipe-item { margin-right: 14px; margin-bottom: 4px; padding: 0; }
.compact-skill .recipe-icon { width: 34px; height: 34px; }
.compact-skill .recipe-amount { font-size: 28px; }
.compact-skill .upgrade-reason { font-size: 26px; margin-bottom: 8px; }
.skill-buy { min-height: 86px; font-size: 34px; margin-top: 0; padding: 10px; }
.paper-pin { position: absolute; right: 16px; top: 10px; width: 46px; height: 58px; rotate: -16deg; }
.pin-needle { position: absolute; left: 23px; top: 25px; width: 5px; height: 31px; background-color: rgb(76, 83, 82); border-left-width: 2px; border-left-color: rgb(225, 233, 225); }
.pin-neck { position: absolute; left: 17px; top: 15px; width: 16px; height: 19px; background-color: rgb(154, 41, 37); }
.pin-head { position: absolute; left: 7px; top: 2px; width: 34px; height: 24px; border-radius: 10px; background-color: rgb(219, 55, 46); border-bottom-width: 5px; border-bottom-color: rgb(130, 35, 32); }
.pin-glint { position: absolute; left: 14px; top: 5px; width: 13px; height: 5px; border-radius: 3px; background-color: rgb(255, 155, 125); }
.locked-skill { height: 310px; min-height: 310px; max-height: 310px; overflow: hidden; }
.locked-skill .skill-content { visibility: hidden; }
.skill-lock-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.skill-lock-cover { position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: rgb(31, 41, 45); }
.skill-lock-cover:hover { background-color: rgb(37, 48, 51); }
.skill-lock-cover:disabled { background-color: rgb(31, 39, 43); opacity: 1; }
.chain-drawing { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.locked-title { position: absolute; top: 16px; left: 20px; right: 20px; color: rgb(233, 234, 211); font-size: 36px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(23, 29, 32); }
.locked-note { position: absolute; left: 10px; right: 10px; bottom: 14px; -unity-text-align: middle-center; font-size: 28px; color: rgb(186, 197, 194); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(23, 29, 32); }
.lock-ready .locked-note { color: rgb(255, 218, 118); }
.compact-button { min-height: 88px; height: 88px; padding: 10px; margin-top: 12px; font-size: 34px; }
.dialog-footer { flex-direction: row; margin-top: 6px; }
.dialog-footer .compact-button { flex-grow: 1; flex-basis: 0; margin-right: 8px; }
.profile-dialog .title { font-size: 40px; margin-bottom: 14px; }
.profile-banner { flex-direction: row; align-items: center; margin-bottom: 18px; }
.profile-rank { width: 106px; height: 106px; font-size: 76px; -unity-text-align: middle-center; color: rgb(244, 227, 159); background-color: rgb(70, 88, 46); border-bottom-width: 6px; border-bottom-color: rgb(39, 55, 29); margin-right: 22px; }
.profile-heading { font-size: 40px; color: rgb(38, 53, 27); }
.profile-progress-label { flex-direction: row; justify-content: space-between; }
.profile-progress-label .section-label { font-size: 26px; margin-bottom: 4px; }
.profile-progress-track { height: 12px; background-color: rgb(148, 157, 123); margin-bottom: 20px; }
.profile-progress-fill { height: 12px; background-color: rgb(77, 120, 49); }
.profile-section { font-size: 28px; color: rgb(86, 94, 66); margin-top: 10px; margin-bottom: 8px; }
.profile-requirements { flex-direction: row; flex-wrap: wrap; }
.profile-resource { width: 48%; flex-direction: row; align-items: center; margin-right: 2%; margin-bottom: 10px; padding: 10px; background-color: rgb(189, 195, 164); }
.profile-resource-icon { width: 52px; height: 52px; margin-right: 12px; flex-shrink: 0; }
.profile-resource-copy { flex-shrink: 1; }
.profile-resource-name { font-size: 25px; color: rgb(79, 88, 58); }
.profile-resource-count { font-size: 29px; }
.profile-note { font-size: 24px; color: rgb(93, 100, 74); margin-top: 0; margin-bottom: 8px; }
.profile-skill-row { min-height: 74px; flex-direction: row; justify-content: space-between; align-items: center; margin: 0 0 5px 0; padding: 8px 12px; background-color: rgb(191, 196, 166); border-width: 0; border-radius: 0; }
.profile-skill-row:hover { background-color: rgb(204, 210, 175); }
.profile-skill-name { font-size: 28px; flex-shrink: 1; color: rgb(48, 65, 33); }
.profile-skill-count { font-size: 30px; margin-left: 10px; }
.profile-coin-row { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 8px; }
.profile-unlocks { margin-top: 6px; margin-bottom: 6px; font-size: 27px; color: rgb(80, 90, 57); }
.profile-unlock-chips { flex-direction: row; flex-wrap: wrap; }
.profile-unlock-chip { font-size: 24px; background-color: rgb(186, 194, 158); color: rgb(66, 81, 41); padding: 7px; margin: 4px; }
.map-card .title { font-size: 40px; margin-bottom: 14px; }
.map-navigation { margin-bottom: 14px; flex-wrap: nowrap; }
.map-tab { flex-grow: 1; flex-basis: 0; min-height: 82px; height: 82px; margin-right: 6px; padding: 8px; font-size: 30px; }
.map-project { position: relative; }
.map-project .paper-pin { top: 16px; right: 16px; background-color: rgb(216, 214, 184); }
.construction-scene { height: 400px; margin-bottom: 14px; border-width: 3px; }
.construction-board { position: absolute; width: 480px; height: 240px; left: 50%; top: 50%; margin-left: -240px; margin-top: -120px; }
.map-title { font-size: 36px; color: rgb(43, 59, 29); margin-bottom: 8px; }
.map-status { font-size: 27px; color: rgb(92, 102, 67); margin-top: 8px; margin-bottom: 8px; }
.map-progress-row { flex-direction: row; justify-content: space-between; }
.map-materials { flex-direction: row; flex-wrap: wrap; }
.map-materials .recipe-item { margin-right: 20px; margin-bottom: 10px; }
.map-materials .recipe-amount { font-size: 30px; }
.map-card .compact-button { margin-top: 12px; }
